---
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  hideNav?: boolean;
}

const {
  title = site.name,
  description = site.description,
  image,
  lang = "en",
  hideNav = false,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const imageUrl = image ? new URL(image, site.url).toString() : undefined;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isChinesePage = lang.toLowerCase().startsWith("zh") || pathname === "/zh";
const navItems = site.nav.map((item) => {
  if (!isChinesePage) return item;

  const zhLabels: Record<string, string> = {
    Research: "研究",
    Notes: "笔记",
    Tweets: "推文",
    Topics: "主题",
    About: "关于",
  };

  return {
    ...item,
    label: zhLabels[item.label] ?? item.label,
  };
});

const languageSwitch = isChinesePage
  ? { label: "EN", href: "/" }
  : { label: "中文", href: "/zh" };

const isActive = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return pathname === normalizedHref || (normalizedHref !== "/" && pathname.startsWith(`${normalizedHref}/`));
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="header-bar">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <img src="/images/kitaku-logo.svg" alt="" width="188" height="52" />
        </a>
        {!hideNav && (
          <nav aria-label="Main navigation">
            {navItems.map((item) => (
              <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))}
            <a class="language-switch" href={languageSwitch.href}>{languageSwitch.label}</a>
          </nav>
        )}
      </header>
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>(c) Kitaku Research, 2026. kitaku.org</p>
    </footer>
    <script>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      document.addEventListener("click", (event) => {
        if (prefersReducedMotion.matches) return;

        const link = event.target instanceof Element
          ? event.target.closest("a")
          : null;

        if (!(link instanceof HTMLAnchorElement)) return;
        if (link.target || link.hasAttribute("download")) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        if (destination.pathname === window.location.pathname && destination.hash) return;

        event.preventDefault();
        document.body.classList.add("is-leaving");
        window.setTimeout(() => {
          window.location.href = destination.href;
        }, 170);
      });

      window.addEventListener("pageshow", () => {
        document.body.classList.remove("is-leaving");
      });
    </script>
  </body>
</html>
