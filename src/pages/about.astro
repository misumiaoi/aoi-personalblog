---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About Kitaku Research.">
  <section class="page-intro narrow">
    <h1>About</h1>
    <p>
      Kitaku Research is a public writing and documentation space for Aoi's
      language education work, creator operations, technical notes, and small
      infrastructure projects.
    </p>
    <p>
      The site is designed as a stable index rather than a fast social feed.
      Writing can be revised, grouped, and made easier to return to over time.
    </p>
  </section>
</BaseLayout>

